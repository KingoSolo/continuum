# CockroachDB connection used by Prisma. Set sslmode=verify-full in deployed environments.
DATABASE_URL="postgresql://username:password@host:26257/continuum?sslmode=verify-full"

# Optional: Amazon S3 archival of Mission Snapshots (additive; entirely skipped if unset).
# When S3_BUCKET and AWS_REGION are both set, each generated Mission Snapshot is
# uploaded as formatted JSON to s3://$S3_BUCKET/mission/{missionId}/snapshots/{snapshotId}.json
# and its object URI is stored on the snapshot record. Upload failures never affect
# snapshot creation.
# S3_BUCKET=continuum-mission-snapshots
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=            # optional, for temporary credentials
# S3_ENDPOINT=                  # optional, for S3-compatible endpoints
